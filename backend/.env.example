# AI Bot Environment
# Generated clean .env

# Security
ADMIN_KEY=
JWT_SECRET=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./data/app.db
# For Postgres later:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/aibot

# AI Providers - add at least one real key
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Default Provider Settings
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.1-8b-instant
FALLBACK_PROVIDERS=groq,openrouter,deepseek,openai

# Token Billing
DEFAULT_CUSTOMER_BALANCE=1000
BASE_REQUEST_COST=5
RAG_COST=3

# Addons
RAG_ENABLED=false
GOOGLE_DRIVE_ENABLED=false

# Google Drive - later phase
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
OPENAI_API_KEY=
BASERAW_API_KEY=
#BASERAW_REGION=us-east-1
